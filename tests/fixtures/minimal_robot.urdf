<?xml version="1.0" encoding="utf-8"?>
<robot name="minimal_robot">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="5" />
      <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.4" />
    </inertial>
    <visual name="base_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="meshes/base.stl" scale="1 1 1" /></geometry>
      <material name="blue"><color rgba="0 0.2 0.8 1" /></material>
    </visual>
    <collision name="base_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.5 0.4 0.2" /></geometry>
    </collision>
  </link>
  <link name="arm_link">
    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.02" />
    </inertial>
    <visual name="arm_visual">
      <origin xyz="0 0 0.25" rpy="0 0 0" />
      <geometry><cylinder radius="0.05" length="0.5" /></geometry>
    </visual>
    <collision name="arm_collision">
      <origin xyz="0 0 0.25" rpy="0 0 0" />
      <geometry><cylinder radius="0.05" length="0.5" /></geometry>
    </collision>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link" />
    <child link="arm_link" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <axis xyz="0 0 2" />
    <limit lower="-1.5" upper="1.5" effort="20" velocity="3" />
    <dynamics damping="0.1" friction="0.01" />
  </joint>
</robot>
