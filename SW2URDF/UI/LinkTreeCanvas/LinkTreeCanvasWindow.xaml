<Window x:Class="SW2URDF.UI.LinkTreeCanvas.LinkTreeCanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SW2URDF Link 树编辑器"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        Background="#F4F6F8"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        KeyDown="WindowKeyDown"
        PreviewMouseLeftButtonUp="WindowPreviewMouseLeftButtonUp">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#D9DEE5" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Link 树编辑器" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Button x:Name="AddChildToolbarButton" Content="+ 添加子 Link" Click="AddChildClick" />
                    <Button Content="复制" Click="CopyClick" />
                    <Button Content="粘贴" Click="PasteClick" />
                    <Button Content="自动整理" Click="AutoLayoutClick" />
                    <Button Content="重置视图" Click="ResetViewClick" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="拖动节点自由排布；拖到另一节点上可改变父级" Foreground="#667085" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="取消" Click="CancelClick" />
                    <Button Content="应用" Margin="0" Click="ApplyClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12" Background="#FAFBFC" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="Viewport" Background="Transparent"
                      MouseWheel="ViewportMouseWheel"
                      PreviewMouseLeftButtonDown="ViewportLeftButtonDown"
                      PreviewMouseLeftButtonUp="ViewportLeftButtonUp"
                      MouseRightButtonDown="ViewportRightButtonDown"
                      MouseRightButtonUp="ViewportRightButtonUp"
                      MouseMove="ViewportMouseMove">
                    <Canvas x:Name="Workspace" Width="2200" Height="1400" Background="#FAFBFC">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Padding="10,6" Background="#E8EDF3" CornerRadius="4">
                        <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#475467" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
                <StackPanel Margin="20">
                    <TextBlock Text="节点属性" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,18" />

                    <TextBlock Text="Link 名称" Foreground="#475467" />
                    <TextBox x:Name="LinkNameTextBox" Margin="0,5,0,4" IsEnabled="False" LostFocus="LinkNameCommit" KeyDown="PropertyTextBoxKeyDown" />
                    <TextBlock x:Name="NameValidationText" Foreground="#C62828" TextWrapping="Wrap" MinHeight="18" />

                    <TextBlock Text="父 Link" Foreground="#475467" Margin="0,10,0,0" />
                    <TextBlock x:Name="ParentNameText" FontWeight="SemiBold" Margin="0,5,0,12" />

                    <TextBlock Text="Joint 名称" Foreground="#475467" />
                    <TextBox x:Name="JointNameTextBox" Margin="0,5,0,12" IsEnabled="False" LostFocus="JointNameCommit" KeyDown="PropertyTextBoxKeyDown" />

                    <TextBlock Text="Joint 类型" Foreground="#475467" />
                    <ComboBox x:Name="JointTypeComboBox" Margin="0,5,0,20" IsEnabled="False" SelectionChanged="JointTypeChanged" />

                    <Button Content="+ 添加子 Link" Click="AddChildClick" Margin="0,0,0,8" />
                    <Button Content="删除整个分支" Click="DeleteSelectedClick" Margin="0,0,0,8" />
                    <Button Content="聚焦当前节点" Click="FocusSelectedClick" Margin="0" />

                    <Border Margin="0,24,0,0" Padding="12" Background="#F2F4F7" CornerRadius="4">
                        <TextBlock TextWrapping="Wrap" Foreground="#475467"
                                   Text="连接箭头表示 Parent → Child。移动节点到空白位置只改变布局；释放到另一个节点上会将其设为新父级。根节点不能删除或改变父级。" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#344054" />
                <TextBlock x:Name="SelectionText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#667085" />
            </Grid>
        </Border>
    </Grid>
</Window>
